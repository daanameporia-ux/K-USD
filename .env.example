# Copy this file to .env and fill in the values. Never commit .env.

# ---- Telegram ----------------------------------------------------------------------------
# Token from @BotFather (looks like 1234567890:AAH...)
BOT_TOKEN=
# webhook on a server with a domain (production); polling only for local development
BOT_MODE=webhook
# Random string, 16+ characters; Telegram sends it with every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Your Telegram ID (and partners'), comma separated: they become superadmins
SUPERADMIN_TG_IDS=
# Optional: ID of a staff group chat for alerts (add the bot there first). Empty = alerts go to admins directly
STAFF_CHAT_ID=

# ---- Domain and HTTPS ----------------------------------------------------------------------
# Domain pointed to the server (A record), without https://
DOMAIN=usdt.example.com
# E-mail for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com
# Public address of the service: https:// + DOMAIN
PUBLIC_BASE_URL=https://usdt.example.com

# ---- Database ----------------------------------------------------------------------------------
# Password of the internal PostgreSQL user (random string). DATABASE_URL is assembled by docker-compose.
POSTGRES_PASSWORD=
# Only when running the app outside docker-compose:
# DATABASE_URL=postgresql://kusd:PASSWORD@localhost:5432/kusd

# ---- Security -------------------------------------------------------------------------------------
# Random string, 32+ characters (sessions are hashed with it)
SESSION_SECRET=

# ---- Payments -------------------------------------------------------------------------------------
# mock = test provider (no real money). In ENV=prod it requires ALLOW_MOCK_IN_PROD=true
PAYMENT_PROVIDER=mock
# Signing secret of mock callbacks, 16+ characters
MOCK_PROVIDER_SECRET=
ALLOW_MOCK_IN_PROD=false

# ---- External data sources (defaults are fine) ----------------------------------------------------
RATE_SOURCE_URL=https://api.rapira.net/open/market/rates
TRON_API_URL=https://api.trongrid.io
# Optional TronGrid API key (https://www.trongrid.io) — raises rate limits
TRON_API_KEY=
BSC_RPC_URLS=https://bsc-dataseed.binance.org,https://bsc-dataseed1.defibit.io

# prod / dev / test
ENV=prod
